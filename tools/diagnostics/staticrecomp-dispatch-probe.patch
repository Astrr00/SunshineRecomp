 }
 
+// Lokale Messung (SunshineRecomp, 2026-09-15): zaehlt, warum DispatchableAt
+// ablehnt. Nicht fuer den Upstream gedacht.
+unsigned long long g_sr_probe_total = 0, g_sr_probe_forced = 0, g_sr_probe_nochunk = 0,
+                   g_sr_probe_hostcall = 0, g_sr_probe_unverified = 0, g_sr_probe_ok = 0;
+unsigned int g_sr_probe_first_bad_chunk = 0xFFFFFFFFu;
+unsigned int g_sr_probe_last_bad_pc = 0;
+
 bool StaticRecompCore::DispatchableAt(u32 address)
 {
+  ++g_sr_probe_total;
   RefreshHostCalls();
   if (!m_forced_fallback_ranges.empty() && IsForcedFallbackAddress(address))
+  {
+    ++g_sr_probe_forced;
     return false;
+  }
   const int index = ChunkIndexOf(address);
-  if (index < 0 || ChunkContainsHostCall(static_cast<u32>(index)))
+  if (index < 0)
+  {
+    ++g_sr_probe_nochunk;
+    g_sr_probe_last_bad_pc = address;
+    return false;
+  }
+  if (ChunkContainsHostCall(static_cast<u32>(index)))
+  {
+    ++g_sr_probe_hostcall;
+    g_sr_probe_last_bad_pc = address;
+    if (g_sr_probe_first_bad_chunk == 0xFFFFFFFFu)
+      g_sr_probe_first_bad_chunk = static_cast<unsigned int>(index);
     return false;
+  }
   ++m_smc_probe_clock;
   if (m_chunk_state[index] == CHUNK_UNVERIFIED)
     VerifyChunk(static_cast<u32>(index));
   else if (m_chunk_state[index] == CHUNK_FAILED &&
            m_smc_probe_clock >= m_chunk_retry_after[index])
     VerifyChunk(static_cast<u32>(index));
-  return m_chunk_state[index] == CHUNK_VERIFIED;
+  const bool ok = m_chunk_state[index] == CHUNK_VERIFIED;
+  if (ok)
+    ++g_sr_probe_ok;
+  else
+  {
+    ++g_sr_probe_unverified;
+    g_sr_probe_last_bad_pc = address;
+  }
+  return ok;
 }
 

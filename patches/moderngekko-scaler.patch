+// Die Kerne des Ausgabe-Skalierers. Der Index ist der Wert, den
+// Data/Sys/Shaders/default_pre_post_process.glsl als resampling_method liest.
+const std::vector<const char *> &SupportedScalers() {
+  static const std::vector<const char *> scalers = {
+      "auto",  "bilinear",       "bspline", "mitchell", "catmull-rom",
+      "sharp-bilinear", "area",  "nearest", "hermite"};
+  return scalers;
+}
+
+int ScalerKernel(std::string_view name) {
+  if (name.empty())
+    return 0;
+  const auto &scalers = SupportedScalers();
+  for (std::size_t i = 0; i < scalers.size(); ++i)
+    if (name == scalers[i])
+      return static_cast<int>(i);
+  return -1;
+}

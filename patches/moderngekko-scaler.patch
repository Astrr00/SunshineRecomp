+// Die Kerne des Ausgabe-Skalierers, in der Reihenfolge, die
+// Data/Sys/Shaders/default_pre_post_process.glsl erwartet. "auto" ueberlaesst
+// das Skalieren der Grafikkarte und ist nicht gammakorrekt; alles andere
+// rechnet in linearem Licht.
+struct ScalerOption {
+  const char *name;
+  int value;
+};
+constexpr ScalerOption kScalers[] = {
+    {"auto", 0},         {"bilinear", 1},       {"bspline", 2},
+    {"mitchell", 3},     {"catmull-rom", 4},    {"sharp-bilinear", 5},
+    {"area", 6},         {"nearest", 7},        {"hermite", 8},
+};
+
+int ScalerValue(std::string_view name) {
+  for (const ScalerOption &option : kScalers)
+    if (name == option.name)
+      return option.value;
+  return -1;
+}

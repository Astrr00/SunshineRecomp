+bool ParseOutputSize(std::string_view value, int* width, int* height) {
+  if (value == "auto") { *width = *height = 0; return true; }
+  const auto x = value.find('x');
+  if (x == std::string_view::npos) return false;
+  const auto w = std::from_chars(value.data(), value.data() + x, *width);
+  const auto h = std::from_chars(value.data() + x + 1, value.data() + value.size(), *height);
+  return w.ec == std::errc{} && w.ptr == value.data() + x &&
+         h.ec == std::errc{} && h.ptr == value.data() + value.size() &&
+         *width >= 320 && *height >= 240 && *width <= 8192 && *height <= 8192;
+}
+
+int LegacyScale(std::string_view resolution) {
+  for (const auto& option : SupportedResolutions())
+    if (resolution == option.text) return option.dolphin_scale;
+  for (int scale = 1; scale <= 12; ++scale)
+    if (resolution == std::to_string(640 * scale) + "x" + std::to_string(528 * scale))
+      return scale;
+  return 0;
+}
+
 fs::path ControllerConfigPath(const fs::path &user_directory) {
 #ifdef MODERNGEKKO_GAMECUBE_CONTROLLERS

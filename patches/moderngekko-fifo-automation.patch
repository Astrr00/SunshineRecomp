   case automation::CommandType::Screenshot:
     SaveAutomationScreenshot(NormalizeScreenshotPath(command.path));
     break;
+  case automation::CommandType::RecordFifo:
+  {
+    if (Core::GetState(system) != Core::State::Running)
+      return RuntimeError{RuntimeErrorCode::InvalidState, "record_fifo requires a running core"};
+    auto& recorder = system.GetFifoRecorder();
+    if (recorder.IsRecording())
+      return RuntimeError{RuntimeErrorCode::InvalidState, "a FIFO recording is already active"};
+    std::filesystem::create_directories(command.path.parent_path());
+    // Save on the recorder's completion callback, while its file is stable.
+    // Shared ownership keeps the callback safe if shutdown interrupts this wait.
+    const auto result = std::make_shared<std::atomic<int>>(0);
+    recorder.StartRecording(static_cast<s32>(command.frames),
+                            [result, path = command.path.string(), &recorder] {
+      const auto* file = recorder.GetRecordedFile();
+      const bool saved = file && recorder.GetRecordedFile()->Save(path);
+      result->store(saved ? 1 : -1, std::memory_order_release);
+    });
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(30);
+    while (result->load(std::memory_order_acquire) == 0 && !stop_token.stop_requested() &&
+           std::chrono::steady_clock::now() < deadline)
+      std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    const int outcome = result->load(std::memory_order_acquire);
+    if (outcome != 1)
+    {
+      recorder.StopRecording();
+      return RuntimeError{RuntimeErrorCode::InvalidState,
+                          outcome == -1 ? "could not save FIFO recording" :
+                          "FIFO recording interrupted or timed out; a partial file may follow"};
+    }
+    break;
+  }
   case automation::CommandType::ReadMemory:

index e6651d5..5f286db 100644
--- a/src/backend/llvm/abi_policy.cpp
+++ b/src/backend/llvm/abi_policy.cpp
@@ -1,6 +1,7 @@
 #include "backend/llvm/llvm_backend.h"
 
 #include <algorithm>
+#include <bitset>
 #include <deque>
 #include <functional>
 #include <unordered_map>
@@ -8,11 +9,14 @@
 
 namespace {
 
+// std::bitset::count statt __builtin_popcountll: MSVC kennt das Builtin nicht,
+// und __popcnt64 wuerde die POPCNT-Instruktion voraussetzen. Compiler bilden
+// diese Form auf dieselbe Instruktion ab, wo sie verfuegbar ist.
 u32 stateCount(const u64 *first, const u64 *second = nullptr) {
   u32 count = 0;
   for (u32 word = 0; word < DOLIR_STATE_MASK_WORDS; word++)
     count += static_cast<u32>(
-        __builtin_popcountll(first[word] | (second ? second[word] : 0u)));
+        std::bitset<64>(first[word] | (second ? second[word] : 0u)).count());
   return count;
 }
 

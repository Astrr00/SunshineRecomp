+#include "VideoCommon/GXDryRun.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+#include "VideoCommon/DataReader.h"
+#include "Common/HookableEvent.h"
+#include "Core/System.h"
+#include "VideoCommon/AbstractTexture.h"
+#include "VideoCommon/BPMemory.h"
+#include "VideoCommon/BoundingBox.h"
+#include "VideoCommon/FramebufferManager.h"
+#include "VideoCommon/CPMemory.h"
+#include "VideoCommon/GeometryShaderManager.h"
+#include "VideoCommon/PixelShaderManager.h"
+#include "VideoCommon/VertexLoaderManager.h"
+#include "VideoCommon/VertexManagerBase.h"
+#include "VideoCommon/XFMemory.h"
+#include "VideoCommon/XFStateManager.h"
+#include "VideoCommon/OpcodeDecoding.h"
+#include "VideoCommon/VideoEvents.h"
+#include "VideoCommon/VideoEvents.h"
+
+namespace GXDryRun
+{
+bool g_active = false;
+bool g_capture = false;
+bool g_no_draw = true;
+
+namespace
+{
+std::vector<u8> s_buffer;
+Common::EventHook s_after_present;
+u64 s_frames = 0;            // zweite Durchlaeufe
+u64 s_bytes = 0;             // mitgeschriebene Bytes insgesamt
+u64 s_blocked_bp = 0;        // gesperrte BP-Schreibvorgaenge im zweiten Durchlauf
+u64 s_decoded_bytes = 0;     // im zweiten Durchlauf dekodierte Bytes
+u64 s_vertices = 0;          // im zweiten Durchlauf geladene Vertices
+u64 s_vertices_first = 0;    // im ersten Durchlauf geladene Vertices
+u64 s_draws = 0;             // Zeichenaufrufe im zweiten Durchlauf
+u64 s_draws_first = 0;       // Zeichenaufrufe im ersten Durchlauf
+u64 s_shadow_dumps = 0;      // gespeicherte Schattenbilder
+u64 s_short_frames = 0;      // zweite Durchlaeufe, die nicht alle Bytes dekodierten
+u64 s_first_short = 0;       // erster solcher Durchlauf (1-basiert), 0 = keiner
+std::string s_dump_dir;      // MODERNGEKKO_GX_DRYRUN_DUMP
+
+// Registerstand am Anfang der Mitschrift. Der Strom eines Bildes setzt nicht
+// jedes Register neu; was er vom Vorbild erbt (etwa Vertexformat und
+// -beschreibung), muss der zweite Durchlauf ebenso erben -- sonst liest er
+// die Zeichenbefehle mit falscher Vertexgroesse und laeuft versetzt (gemessen:
+// 15 von 2.403 Bildern, docs/20).
+struct Snapshot
+{
+  CPState cp;
+  XFMemory xf;
+  BPMemory bp;
+};
+Snapshot s_start;   // Stand am Anfang der laufenden Mitschrift
+Snapshot s_end;     // Stand am Ende, wird nach dem zweiten Durchlauf zurueckgesetzt
+
+void Take(Snapshot* into)
+{
+  std::memcpy(&into->cp, &g_main_cp_state, sizeof(CPState));
+  std::memcpy(&into->xf, &xfmem, sizeof(XFMemory));
+  std::memcpy(&into->bp, &bpmem, sizeof(BPMemory));
+}
+
+void Apply(const Snapshot& from)
+{
+  auto& system = Core::System::GetInstance();
+  std::memcpy(&g_main_cp_state, &from.cp, sizeof(CPState));
+  std::memcpy(&xfmem, &from.xf, sizeof(XFMemory));
+  std::memcpy(&bpmem, &from.bp, sizeof(BPMemory));
+  // Wie VideoCommon_DoState nach dem Laden eines Sicherungsstands.
+  VertexLoaderManager::MarkAllDirty();
+  system.GetPixelShaderManager().Dirty();
+  system.GetGeometryShaderManager().Dirty();
+  system.GetXFStateManager().InvalidateXFRange(0, 0x1000);
+  system.GetXFStateManager().SetProjectionChanged();
+  system.GetPixelShaderManager().SetViewportChanged();
+}
+}  // namespace
+
+void CountVertices(int count)
+{
+  (g_active ? s_vertices : s_vertices_first) += static_cast<u64>(count);
+}
+
+void CountDraw()
+{
+  ++(g_active ? s_draws : s_draws_first);
+}
+
+bool BlocksBPRegister(u8 address)
+{
+  switch (address)
+  {
+  case BPMEM_TRIGGER_EFB_COPY:
+  case BPMEM_CLEARBBOX1:
+  case BPMEM_CLEARBBOX2:
+  case BPMEM_SETDRAWDONE:
+  case BPMEM_PE_TOKEN_ID:
+  case BPMEM_PE_TOKEN_INT_ID:
+  case BPMEM_LOADTLUT0:
+  case BPMEM_LOADTLUT1:
+  case BPMEM_TEXINVALIDATE:
+  case BPMEM_PRELOAD_MODE:
+  case BPMEM_CLEAR_PIXEL_PERF:
+    if (g_active)
+      ++s_blocked_bp;
+    return true;
+  default:
+    return false;
+  }
+}
+
+void Record(const u8* data, u32 size)
+{
+  s_buffer.insert(s_buffer.end(), data, data + size);
+  s_bytes += size;
+}
+
+static void SecondPass(PresentInfo&)
+{
+  if (s_buffer.empty())
+    return;
+  // Der zweite Durchlauf laeuft auf demselben Faden wie der erste, nach dem
+  // Praesentieren. Die Mitschrift enthaelt Display-Listen bereits aufgeloest.
+  auto& system = Core::System::GetInstance();
+  // Nichts, was der Gast liest, darf sich aendern: die Bounding Box wird im
+  // Pixelshader fortgeschrieben, die Pixelzaehler beim Zeichnen.
+  const bool bbox_was_enabled = g_bounding_box && g_bounding_box->IsEnabled();
+  if (bbox_was_enabled)
+    g_bounding_box->Disable(system.GetPixelShaderManager());
+  if (!g_no_draw)
+    g_framebuffer_manager->SwapInShadow();
+  Take(&s_end);
+  Apply(s_start);
+  g_active = true;
+  u32 cycles = 0;
+  DataReader reader(s_buffer.data(), s_buffer.data() + s_buffer.size());
+  const u8* end = OpcodeDecoder::RunFifo<false>(reader, &cycles);
+  const u64 decoded = static_cast<u64>(end - s_buffer.data());
+  s_decoded_bytes += decoded;
+  if (decoded != s_buffer.size())
+  {
+    ++s_short_frames;
+    if (s_first_short == 0)
+      s_first_short = s_frames + 1;
+    std::fprintf(stderr, "[gx-dryrun] Durchlauf %llu: %llu von %llu Bytes dekodiert\n",
+                 (unsigned long long)(s_frames + 1), (unsigned long long)decoded,
+                 (unsigned long long)s_buffer.size());
+  }
+  g_vertex_manager->Flush();
+  g_active = false;
+  if (!g_no_draw)
+  {
+    if (!s_dump_dir.empty() && (s_frames % 60) == 0)
+    {
+      // Der Schatten ist gerade der aktive EFB; sein Farbbild abspeichern.
+      if (g_framebuffer_manager->GetEFBColorTexture()->Save(
+              s_dump_dir + "/schatten_" + std::to_string(s_frames) + ".png", 0))
+        ++s_shadow_dumps;
+      // Zum Vergleich der eigentliche EFB zu diesem Zeitpunkt (nach dem Tausch
+      // ist er der Schatten-Zeiger).
+      g_framebuffer_manager->SwapOutShadow();
+      g_framebuffer_manager->GetEFBColorTexture()->Save(
+          s_dump_dir + "/efb_" + std::to_string(s_frames) + ".png", 0);
+      g_framebuffer_manager->SwapInShadow();
+    }
+    g_framebuffer_manager->SwapOutShadow();
+  }
+  Apply(s_end);
+  if (bbox_was_enabled)
+    g_bounding_box->Enable(system.GetPixelShaderManager());
+  ++s_frames;
+  s_buffer.clear();
+  Take(&s_start);  // die naechste Mitschrift beginnt hier
+}
+
+void Initialize()
+{
+  const char* stufe = std::getenv("MODERNGEKKO_GX_DRYRUN");
+  g_capture = stufe != nullptr;
+  g_no_draw = !(stufe && stufe[0] == '2');
+  const char* dump = std::getenv("MODERNGEKKO_GX_DRYRUN_DUMP");
+  s_dump_dir = dump ? dump : "";
+  g_active = false;
+  s_buffer.clear();
+  s_frames = s_bytes = s_blocked_bp = s_decoded_bytes = s_vertices = s_shadow_dumps = 0;
+  s_vertices_first = s_draws = s_draws_first = s_short_frames = s_first_short = 0;
+  if (!g_capture)
+    return;
+  s_buffer.reserve(4u << 20);
+  Take(&s_start);
+  s_after_present = Core::System::GetInstance().GetVideoEvents().after_present_event.Register(
+      SecondPass);
+}
+
+void Shutdown()
+{
+  s_after_present.reset();
+  if (g_capture)
+  {
+    std::fprintf(stderr,
+                 "[gx-dryrun] stufe=%d frames=%llu bytes=%llu decoded=%llu blocked_bp=%llu "
+                 "vertices=%llu/%llu draws=%llu/%llu schattenbilder=%llu kurz=%llu/erster=%llu\n",
+                 g_no_draw ? 1 : 2, (unsigned long long)s_frames, (unsigned long long)s_bytes,
+                 (unsigned long long)s_decoded_bytes, (unsigned long long)s_blocked_bp,
+                 (unsigned long long)s_vertices, (unsigned long long)s_vertices_first,
+                 (unsigned long long)s_draws, (unsigned long long)s_draws_first,
+                 (unsigned long long)s_shadow_dumps, (unsigned long long)s_short_frames,
+                 (unsigned long long)s_first_short);
+  }
+  g_capture = false;
+  g_active = false;
+  s_buffer.clear();
+  s_buffer.shrink_to_fit();
+}
+}  // namespace GXDryRun

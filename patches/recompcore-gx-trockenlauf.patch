+
+void OnDraw(int primitive, int vat, int count, int vertex_size, int pos_kind, bool per_vertex_matrix)
+{
+  if (!g_interpolate)
+    return;
+  if (!g_active)
+  {
+    DrawRecord r;
+    r.signature = std::make_tuple(primitive, vat, count, vertex_size, pos_kind, per_vertex_matrix);
+    TakeMatrices(&r);
+    s_draws_current.push_back(std::move(r));
+    return;
+  }
+  // Zweiter Durchlauf von B: Zeichenbefehl j.
+  const size_t j = static_cast<size_t>(s_draw_index++);
+  const bool matched = j < s_match_of_current.size() && s_match_of_current[j] >= 0;
+  if (s_draw_log)
+    std::fprintf(s_draw_log, "draw %zu match %d sig %d %d %d %d %d %d\n", j,
+                 matched ? s_match_of_current[j] : -1, primitive, vat, count, vertex_size, pos_kind,
+                 per_vertex_matrix ? 1 : 0);
+  if (!matched)
+    return;
+  const DrawRecord& da = s_draws_previous[static_cast<size_t>(s_match_of_current[j])];
+  const DrawRecord& db = s_draws_frame[j];
+  ++s_draws_matched;
+  // Geaenderte Woerter als zusammenhaengende Pakete laden.
+  bool patched = false;
+  int run_start = -1;
+  std::vector<u32> run;
+  auto flush_run = [&]() {
+    if (run_start >= 0)
+    {
+      if (s_draw_log)
+      {
+        std::fprintf(s_draw_log, "  load 0x%03X n=%zu:", SnapshotAddress(run_start), run.size());
+        for (size_t k = 0; k < run.size(); ++k)
+          std::fprintf(s_draw_log, " %08X/%08X/%08X", da.matrices[run_start + k], db.matrices[run_start + k], run[k]);
+        std::fprintf(s_draw_log, "\n");
+      }
+      LoadWords(SnapshotAddress(run_start), run);
+      s_words_interpolated += run.size();
+      patched = true;
+    }
+    run_start = -1;
+    run.clear();
+  };
+  // Geladen wird nur, was sich von A nach B geaendert hat UND noch nicht
+  // anliegt: Das Spiel laedt Matrizen nicht vor jedem Zeichenbefehl neu, der
+  // vorige zugeordnete Zeichenbefehl hat den Zwischenwert also meist schon
+  // gesetzt -- und jedes Laden erzwingt einen Flush. Ohne diese Pruefung
+  // hatte der zweite Durchlauf zehnmal so viele Zeichenaufrufe wie der erste
+  // (3,78 Millionen statt 375 Tausend, docs/20).
+  const u32* live = reinterpret_cast<const u32*>(&xfmem);
+  for (int i = 0; i < kSnapshotWords; ++i)
+  {
+    const bool changed = da.matrices[i] != db.matrices[i];
+    const u32 wanted = changed ? LerpWords(da.matrices[i], db.matrices[i], s_t) : 0;
+    if (changed && live[SnapshotAddress(i)] != wanted)
+    {
+      if (run_start >= 0 && SnapshotAddress(i) != SnapshotAddress(run_start) + run.size())
+        flush_run();
+      if (run_start < 0)
+        run_start = i;
+      run.push_back(wanted);
+    }
+    else
+    {
+      if (changed)
+        ++s_words_already;
+      if (run_start >= 0)
+        flush_run();
+    }
+  }
+  flush_run();
+  if (da.projection != db.projection && da.projection[6] == db.projection[6])
+  {
+    std::vector<u32> p(kProjectionWords);
+    for (int i = 0; i < 6; ++i)
+      p[i] = LerpWords(da.projection[i], db.projection[i], s_t);
+    p[6] = db.projection[6];
+    if (!std::equal(p.begin(), p.end(), live + 0x1020))
+    {
+      LoadWords(0x1020, p);
+      ++s_projection_patched;
+      patched = true;
+    }
+    else
+      s_words_already += kProjectionWords;
+  }
+  if (patched)
+    ++s_draws_patched;
+}
+
+bool BlocksBPRegister(u8 address)
+{
+  switch (address)
+  {
+  // BPMEM_TRIGGER_EFB_COPY fehlt absichtlich: die Kopie wird in BPStructs.cpp
+  // uebersprungen, ihr Loeschen aber ausgefuehrt (NoteBlockedCopy).
+  case BPMEM_CLEARBBOX1:
+  case BPMEM_CLEARBBOX2:
+  case BPMEM_SETDRAWDONE:
+  case BPMEM_PE_TOKEN_ID:
+  case BPMEM_PE_TOKEN_INT_ID:
+  case BPMEM_LOADTLUT0:
+  case BPMEM_LOADTLUT1:
+  case BPMEM_TEXINVALIDATE:
+  case BPMEM_PRELOAD_MODE:
+  case BPMEM_CLEAR_PIXEL_PERF:
+    if (g_active)
+      ++s_blocked_bp;
+    return true;
+  default:
+    return false;
+  }
+}
+
+void NoteBlockedCopy()
+{
+  ++s_blocked_bp;
+}
+
+const AbstractTexture* PresentOverride(MathUtil::Rectangle<int>* source_rc)
+{
+  if (!s_mid_ready || !s_mid_valid || !s_mid_texture)
+    return nullptr;
+  *source_rc = s_mid_src_rect;
+  return s_mid_texture.get();
+}
+
+void Record(const u8* data, u32 size)
+{
+  s_buffer.insert(s_buffer.end(), data, data + size);
+  s_bytes += size;
+}
+
+// Ohne Fenster alle 60 Bilder; mit _FROM/_COUNT ein Fenster, mit _EVERY
+// dasselbe Fenster alle N Bilder ab _FROM wiederholt.
+static bool DumpNow(u64 index)
+{
+  if (s_dump_dir.empty())
+    return false;
+  if (!s_dump_count)
+    return (index % 60) == 0;
+  if (index < s_dump_from)
+    return false;
+  const u64 offset = index - s_dump_from;
+  return (s_dump_every ? offset % s_dump_every : offset) < s_dump_count;
+}
+
+// Erster Durchlauf, XFB-Kopie ausgefuehrt, Loeschen noch nicht: Bild
+// abgeschlossen. Der EFB zeigt jetzt das vollstaendige Bild -- der
+// Vergleichswert fuer das Schattenbild desselben Bildes.
+static void OnFrameEnd(Core::System&)
+{
+  if (g_active || !g_capture)
+    return;
+  if (s_frame_ready)
+    ++s_frames_dropped;
+  const u64 index = s_frames_done++;
+  if (!g_no_draw && DumpNow(index))
+    g_framebuffer_manager->GetEFBColorTexture()->Save(
+        s_dump_dir + "/efb_" + std::to_string(index) + ".png", 0);
+  s_frame.swap(s_buffer);
+  s_buffer.clear();
+  s_frame_ready = true;
+  s_frame_index = index;
+  s_frame_src_rect = MathUtil::Rectangle<int>(
+      bpmem.copyTexSrcXY.x, bpmem.copyTexSrcXY.y, bpmem.copyTexSrcXY.x + bpmem.copyTexSrcWH.x + 1,
+      bpmem.copyTexSrcXY.y + bpmem.copyTexSrcWH.y + 1);
+  // Wie BPStructs.cpp fuer die XFB-Kopie: Zeilenzahl aus der Y-Skalierung.
+  {
+    const UPE_Copy copy = bpmem.triggerEFBCopy;
+    const float y_scale = copy.scale_invert ? 256.0f / static_cast<float>(bpmem.dispcopyyscale) :
+                                              static_cast<float>(bpmem.dispcopyyscale) / 256.0f;
+    static constexpr float gamma_lut[4] = {1.0f, 1.7f, 2.2f, 2.2f};
+    s_frame_xfb.width = s_frame_src_rect.GetWidth();
+    s_frame_xfb.height = static_cast<u32>(1.0f + bpmem.copyTexSrcWH.y * y_scale);
+    s_frame_xfb.y_scale = y_scale;
+    s_frame_xfb.gamma = gamma_lut[static_cast<u32>(copy.gamma.Value()) & 3];
+    s_frame_xfb.clamp_top = copy.clamp_top != 0;
+    s_frame_xfb.clamp_bottom = copy.clamp_bottom != 0;
+    s_frame_xfb.filter = bpmem.copyfilter.GetCoefficients();
+  }
+  CopySnapshot(&s_frame_start, s_start);
+  Take(&s_start);  // die naechste Mitschrift beginnt mit der XFB-Kopie selbst
+  if (g_interpolate)
+  {
+    s_draws_frame.swap(s_draws_current);
+    s_draws_current.clear();
+  }
+}
+
+static void SecondPass(PresentInfo& info)
+{
+  // Laeuft vor dem Praesentieren (before_present_event), damit das
+  // Zwischenbild an dessen Stelle treten kann.
+  const bool duplicate = info.reason == PresentInfo::PresentReason::VideoInterfaceDuplicate;
+  const bool previous_duplicate = s_last_was_duplicate;
+  s_last_was_duplicate = duplicate;
+  ++s_presents;
+  if (duplicate)
+    ++s_presents_duplicate;
+  if (s_presents % 300 == 0)
+    std::fprintf(stderr, "[gx-dryrun] praesentiert=%llu dup=%llu bilder=%llu mid=%llu\n",
+                 (unsigned long long)s_presents, (unsigned long long)s_presents_duplicate,
+                 (unsigned long long)s_frames_done, (unsigned long long)s_presented_mid);
+  s_mid_ready = false;
+  if (!s_frame_ready)
+    return;
+  s_frame_ready = false;
+  // Der erste Durchlauf hat beim Praesentieren meist schon Vertices des
+  // naechsten Bildes gesammelt, aber noch nicht gezeichnet. Die muessen
+  // jetzt in den eigentlichen EFB -- sonst landen sie im Schatten (Stufe 2
+  // und 3) oder werden mit dem cullall-Stapel verworfen (Stufe 1).
+  g_vertex_manager->Flush();
+  // Der zweite Durchlauf laeuft auf demselben Faden wie der erste, nach dem
+  // Praesentieren. Die Mitschrift enthaelt Display-Listen bereits aufgeloest.
+  auto& system = Core::System::GetInstance();
+  // Nichts, was der Gast liest, darf sich aendern: die Bounding Box wird im
+  // Pixelshader fortgeschrieben, die Pixelzaehler beim Zeichnen.
+  const bool bbox_was_enabled = g_bounding_box && g_bounding_box->IsEnabled();
+  if (bbox_was_enabled)
+    g_bounding_box->Disable(system.GetPixelShaderManager());
+  if (!g_no_draw)
+    g_framebuffer_manager->SwapInShadow();
+  Take(&s_end);
+  Apply(s_frame_start);
+  bool interpolate_this = false;
+  if (g_interpolate)
+  {
+    MatchDraws();
+    size_t matched = 0;
+    for (int k : s_match_of_current)
+      matched += k >= 0;
+    const size_t larger = std::max(s_draws_previous.size(), s_draws_frame.size());
+    interpolate_this = larger > 0 && matched * 10 >= larger * 6;  // spike.cut_verdict: share_floor 0.6
+    if (!interpolate_this)
+    {
+      ++s_cuts;
+      std::fill(s_match_of_current.begin(), s_match_of_current.end(), -1);
+    }
+    else
+      ++s_frames_interpolated;
+    s_draw_index = 0;
+  }
+  if (g_interpolate && DumpNow(s_frame_index))
+    s_draw_log = std::fopen((s_dump_dir + "/draws_" + std::to_string(s_frame_index) + ".txt").c_str(), "w");
+  g_active = true;
+  u32 cycles = 0;
+  DataReader reader(s_frame.data(), s_frame.data() + s_frame.size());
+  const u8* end = OpcodeDecoder::RunFifo<false>(reader, &cycles);
+  const u64 decoded = static_cast<u64>(end - s_frame.data());
+  s_decoded_bytes += decoded;
+  if (decoded != s_frame.size())
+  {
+    ++s_short_frames;
+    if (s_first_short == 0)
+      s_first_short = s_frames + 1;
+    std::fprintf(stderr, "[gx-dryrun] Durchlauf %llu (Bild %llu): %llu von %llu Bytes dekodiert\n",
+                 (unsigned long long)(s_frames + 1), (unsigned long long)s_frame_index,
+                 (unsigned long long)decoded, (unsigned long long)s_frame.size());
+  }
+  g_vertex_manager->Flush();
+  g_active = false;
+  if (s_draw_log)
+  {
+    std::fclose(s_draw_log);
+    s_draw_log = nullptr;
+  }
+  if (!g_no_draw)
+  {
+    // Der Schatten ist gerade der aktive EFB; sein Farbbild abspeichern. Das
+    // Vergleichsbild efb_<n>.png entstand an der Bildgrenze (OnFrameEnd).
+    if (DumpNow(s_frame_index) &&
+        g_framebuffer_manager->GetEFBColorTexture()->Save(
+            s_dump_dir + "/schatten_" + std::to_string(s_frame_index) + ".png", 0))
+      ++s_shadow_dumps;
+    // Stufe 4: nur ein interpoliertes Bild, nur bei 30 Bildern je Sekunde
+    // (vorige Praesentation eine Wiederholung, diese ein neues Bild). Der
+    // Schatten ist noch der aktive EFB: XFB-Kopie in die Zwischenbild-Textur.
+    s_mid_valid = false;
+    if (g_present_mid && interpolate_this && !duplicate && previous_duplicate &&
+        s_frame_xfb.width > 0 && s_frame_xfb.height > 0)
+    {
+      const u32 w = g_framebuffer_manager->EFBToScaledX(s_frame_xfb.width);
+      const u32 h = g_framebuffer_manager->EFBToScaledY(s_frame_xfb.height);
+      if (!s_mid_texture || s_mid_texture->GetWidth() != w || s_mid_texture->GetHeight() != h)
+      {
+        s_mid_framebuffer.reset();
+        s_mid_texture = g_gfx->CreateTexture(
+            TextureConfig(w, h, 1, g_framebuffer_manager->GetEFBLayers(), 1,
+                          AbstractTextureFormat::RGBA8, AbstractTextureFlag_RenderTarget,
+                          AbstractTextureType::Texture_2DArray),
+            "GXDryRun Zwischenbild");
+        if (s_mid_texture)
+          s_mid_framebuffer = g_gfx->CreateFramebuffer(s_mid_texture.get(), nullptr);
+      }
+      if (s_mid_texture && s_mid_framebuffer)
+      {
+        const bool linear_filter =
+            g_framebuffer_manager->GetEFBScale() != 1 || s_frame_xfb.y_scale > 1.0f;
+        g_texture_cache->CopyEFBToTarget(s_mid_framebuffer.get(), s_mid_texture.get(),
+                                         s_frame_src_rect, linear_filter, s_frame_xfb.gamma,
+                                         s_frame_xfb.clamp_top, s_frame_xfb.clamp_bottom,
+                                         s_frame_xfb.filter);
+        s_mid_valid = true;
+        s_mid_ready = true;
+        if (DumpNow(s_frame_index))
+          s_mid_texture->Save(s_dump_dir + "/mid_" + std::to_string(s_frame_index) + ".png", 0);
+        s_mid_src_rect = MathUtil::Rectangle<int>(0, 0, static_cast<int>(w), static_cast<int>(h));
+        ++s_presented_mid;
+      }
+    }
+    g_framebuffer_manager->SwapOutShadow();
+  }
+  Apply(s_end);
+  if (bbox_was_enabled)
+    g_bounding_box->Enable(system.GetPixelShaderManager());
+  ++s_frames;
+  s_frame.clear();
+  if (g_interpolate)
+  {
+    s_draws_previous.swap(s_draws_frame);
+    s_draws_frame.clear();
+  }
+}
+
+void Initialize()
+{
+  const char* stufe = std::getenv("MODERNGEKKO_GX_DRYRUN");
+  g_capture = stufe != nullptr;
+  g_no_draw = !(stufe && (stufe[0] == '2' || stufe[0] == '3'));
+  g_interpolate = stufe && stufe[0] == '3';
+  const char* present = std::getenv("MODERNGEKKO_GX_DRYRUN_PRESENT");
+  g_present_mid = g_interpolate && present && present[0] == '1';
+  s_mid_ready = s_last_was_duplicate = false;
+  s_presents = s_presents_duplicate = s_presented_mid = 0;
+  if (const char* f = std::getenv("MODERNGEKKO_GX_DRYRUN_DUMP_FROM"))
+    s_dump_from = std::strtoull(f, nullptr, 10);
+  if (const char* c = std::getenv("MODERNGEKKO_GX_DRYRUN_DUMP_COUNT"))
+    s_dump_count = std::strtoull(c, nullptr, 10);
+  if (const char* e = std::getenv("MODERNGEKKO_GX_DRYRUN_DUMP_EVERY"))
+    s_dump_every = std::strtoull(e, nullptr, 10);
+  const char* dump = std::getenv("MODERNGEKKO_GX_DRYRUN_DUMP");
+  s_dump_dir = dump ? dump : "";
+  g_active = false;
+  s_buffer.clear();
+  s_frames = s_bytes = s_blocked_bp = s_decoded_bytes = s_vertices = s_shadow_dumps = 0;
+  s_vertices_first = s_draws = s_draws_first = s_short_frames = s_first_short = 0;
+  if (!g_capture)
+    return;
+  s_buffer.reserve(4u << 20);
+  s_frame.reserve(4u << 20);
+  s_frame.clear();
+  s_frame_ready = false;
+  s_frame_index = s_frames_done = s_frames_dropped = 0;
+  Take(&s_start);
+  s_after_frame =
+      Core::System::GetInstance().GetVideoEvents().after_frame_event.Register(OnFrameEnd);
+  s_after_present = Core::System::GetInstance().GetVideoEvents().before_present_event.Register(
+      SecondPass);
+}
+
+void Shutdown()
+{
+  s_after_present.reset();
+  s_after_frame.reset();
+  s_mid_framebuffer.reset();
+  s_mid_texture.reset();
+  s_mid_valid = s_mid_ready = false;
+  if (g_capture)
+  {
+    std::fprintf(stderr,
+                 "[gx-dryrun] stufe=%d frames=%llu bytes=%llu decoded=%llu blocked_bp=%llu "
+                 "vertices=%llu/%llu draws=%llu/%llu schattenbilder=%llu kurz=%llu/erster=%llu "
+                 "bilder=%llu/verworfen=%llu praesentiert=%llu/dup=%llu/mid=%llu "
+                 "interp: frames=%llu cuts=%llu matched=%llu patched=%llu words=%llu schon=%llu proj=%llu\n",
+                 g_interpolate ? 3 : g_no_draw ? 1 : 2, (unsigned long long)s_frames, (unsigned long long)s_bytes,
+                 (unsigned long long)s_decoded_bytes, (unsigned long long)s_blocked_bp,
+                 (unsigned long long)s_vertices, (unsigned long long)s_vertices_first,
+                 (unsigned long long)s_draws, (unsigned long long)s_draws_first,
+                 (unsigned long long)s_shadow_dumps, (unsigned long long)s_short_frames,
+                 (unsigned long long)s_first_short, (unsigned long long)s_frames_done,
+                 (unsigned long long)s_frames_dropped, (unsigned long long)s_presents,
+                 (unsigned long long)s_presents_duplicate, (unsigned long long)s_presented_mid,
+                 (unsigned long long)s_frames_interpolated,
+                 (unsigned long long)s_cuts, (unsigned long long)s_draws_matched,
+                 (unsigned long long)s_draws_patched, (unsigned long long)s_words_interpolated,
+                 (unsigned long long)s_words_already, (unsigned long long)s_projection_patched);
+  }
+  g_capture = false;
+  g_active = false;
+  s_buffer.clear();
+  s_buffer.shrink_to_fit();
+  s_frame.clear();
+  s_frame.shrink_to_fit();
+}
+}  // namespace GXDryRun

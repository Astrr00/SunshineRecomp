+// Laedt ein XF-Wort-Paket ueber den regulaeren Weg (mit Flush und Markierung).
+void LoadWords(u32 address, const std::vector<u32>& words)
+{
+  std::vector<u8> be(words.size() * 4);
+  for (size_t k = 0; k < words.size(); ++k)
+  {
+    be[k * 4 + 0] = static_cast<u8>(words[k] >> 24);
+    be[k * 4 + 1] = static_cast<u8>(words[k] >> 16);
+    be[k * 4 + 2] = static_cast<u8>(words[k] >> 8);
+    be[k * 4 + 3] = static_cast<u8>(words[k]);
+  }
+  for (size_t off = 0; off < words.size(); off += 16)
+  {
+    const u8 n = static_cast<u8>(std::min<size_t>(16, words.size() - off));
+    LoadXFReg(static_cast<u16>(address + off), n, be.data() + off * 4);
+  }
+}

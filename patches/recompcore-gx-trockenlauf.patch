+  // Der Schatten beginnt leer -- die EFB-Kopie mit Loeschen, die das Bild
+  // sonst einleitet, ist im zweiten Durchlauf gesperrt.
+  ClearEFB(MathUtil::Rectangle<int>(0, 0, EFB_WIDTH, EFB_HEIGHT), true, true, true, 0,
+           0xFFFFFF, bpmem.zcontrol.pixel_format);
+}
+
+void FramebufferManager::SwapOutShadow()
+{
+  if (!m_shadow_active)
+    return;
+  std::swap(m_efb_color_texture, m_shadow_color_texture);
+  std::swap(m_efb_convert_color_texture, m_shadow_convert_color_texture);
+  std::swap(m_efb_depth_texture, m_shadow_depth_texture);
+  std::swap(m_efb_framebuffer, m_shadow_framebuffer);
+  std::swap(m_efb_convert_framebuffer, m_shadow_convert_framebuffer);
+  m_shadow_active = false;
+  BindEFBFramebuffer();
+}

+// Trockenlauf des GX-Befehlsstroms (WP14, Schritt 1; docs/20-VARIABLE-BILDRATE.md).
+//
+// Mit MODERNGEKKO_GX_DRYRUN=1 wird der Befehlsstrom jedes Bildes mitgeschrieben
+// und nach dem Praesentieren ein zweites Mal dekodiert -- ohne zu zeichnen und
+// ohne einen Zustand zu beruehren, den das Spiel liest. Die Frage, die dieser
+// Schritt beantwortet: Laesst sich der Strom ein zweites Mal ausfuehren, ohne
+// Tonstrom und Bildzaehler zu veraendern?
+
+#pragma once
+
+#include <vector>
+
+#include "Common/CommonTypes.h"
+#include "Common/MathUtil.h"
+
+class AbstractTexture;
+
+namespace GXDryRun
+{
+// Waehrend des zweiten Durchlaufs wahr: BPWritten sperrt die zehn Register mit
+// gastseitiger Wirkung und fuehrt von der EFB-Kopie nur das Loeschen aus; in
+// Stufe 1 zeichnet der Vertexlader nichts.
+extern bool g_active;
+// Mitschrift eingeschaltet (Umgebungsvariable MODERNGEKKO_GX_DRYRUN=1 oder 2).
+extern bool g_capture;
+// Stufe 1: nichts zeichnen (cullall). Stufe 2: in den Schatten-EFB zeichnen.
+extern bool g_no_draw;
+
+// Vom Vertexlader im zweiten Durchlauf gerufen.
+void CountVertices(int count);
+// Vom Vertexlader je Zeichenbefehl gerufen, in beiden Durchlaeufen. Im ersten
+// wird die Signatur samt XF-Stand gemerkt, im zweiten (Stufe 3) vor dem
+// Zeichnen der interpolierte XF-Stand geladen.
+void OnDraw(int primitive, int vat, int count, int vertex_size, int pos_kind, bool per_vertex_matrix);
+// Vom Vertexmanager je Zeichenaufruf gerufen (beide Durchlaeufe).
+void CountDraw();
+
+void Initialize();
+void Shutdown();
+
+// Vom Dekodierer je GP-Befehl gerufen (nicht fuer GX_CMD_CALL_DL, dessen
+// Inhalt kommt einzeln).
+void Record(const u8* data, u32 size);
+
+// Sperrt ein BP-Register im zweiten Durchlauf? Genau die Liste aus
+// BPWritten (BPStructs.cpp), die Dolphin selbst als Register mit Nebenwirkung
+// fuehrt.
+bool BlocksBPRegister(u8 address);
+// Von BPWritten gerufen, wenn im zweiten Durchlauf eine EFB-Kopie (Textur,
+// RAM oder XFB) uebersprungen wurde.
+void NoteBlockedCopy();
+
+// Stufe 4 (MODERNGEKKO_GX_DRYRUN_PRESENT=1): Das Zwischenbild wird an Stelle
+// des XFB praesentiert, wenn das Spiel gerade mit 30 Bildern je Sekunde
+// laeuft (die vorige Praesentation war eine Wiederholung) und die anstehende
+// ein neues Bild bringt; die Wiederholung danach zeigt das echte Bild. Die
+// Ausgaberate bleibt. Liefert das Zwischenbild und setzt source_rc auf den
+// EFB-Ausschnitt der XFB-Kopie, sonst nullptr.
+const AbstractTexture* PresentOverride(MathUtil::Rectangle<int>* source_rc);
+}  // namespace GXDryRun

+struct Snapshot
+{
+  CPState cp;
+  XFMemory xf;
+  BPMemory bp;
+  // Die abgeleiteten Zustaende der Shader-Verwalter (Konstantenpuffer und
+  // Schmutzmarken), serialisiert wie in einem Sicherungsstand. Ein blosses
+  // Neu-Markieren reichte nicht: InvalidateXFRange(0, 0x1000) rechnet den
+  // Anfang der Nachtransformations- und Lichtbereiche absolut statt relativ
+  // (XFStateManager.cpp) -- SetConstants kopierte dann hinter den
+  // Konstantenpuffer, gefunden mit valgrind (docs/20).
+  std::vector<u8> managers;
+};
+
+void DoManagers(PointerWrap& p)
+{
+  auto& system = Core::System::GetInstance();
+  system.GetPixelShaderManager().DoState(p);
+  system.GetVertexShaderManager().DoState(p);
+  system.GetGeometryShaderManager().DoState(p);
+  system.GetXFStateManager().DoState(p);
+}
+
+void CopySnapshot(Snapshot* to, const Snapshot& from)
+{
+  std::memcpy(&to->cp, &from.cp, sizeof(CPState));
+  std::memcpy(&to->xf, &from.xf, sizeof(XFMemory));
+  std::memcpy(&to->bp, &from.bp, sizeof(BPMemory));
+  to->managers = from.managers;
+}
+Snapshot s_start;   // Stand am Anfang der laufenden Mitschrift
+Snapshot s_end;     // Stand am Ende, wird nach dem zweiten Durchlauf zurueckgesetzt

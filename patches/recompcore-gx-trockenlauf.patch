+u32 LerpWords(u32 a, u32 b, float t)
+{
+  float fa, fb;
+  std::memcpy(&fa, &a, 4);
+  std::memcpy(&fb, &b, 4);
+  const float v = fa + (fb - fa) * t;
+  u32 out;
+  std::memcpy(&out, &v, 4);
+  return out;
+}

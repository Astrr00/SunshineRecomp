+void TakeMatrices(DrawRecord* r)
+{
+  const u32* words = reinterpret_cast<const u32*>(&xfmem);
+  std::copy(words + 0x000, words + 0x100, r->matrices.begin());
+  std::copy(words + 0x400, words + 0x460, r->matrices.begin() + 256);
+  std::copy(words + 0x500, words + 0x600, r->matrices.begin() + 352);
+  std::copy(words + 0x1020, words + 0x1027, r->projection.begin());
+}
+
+u32 SnapshotAddress(int i)
+{
+  return i < 256 ? i : i < 352 ? 0x400 + (i - 256) : 0x500 + (i - 352);
+}
+
+u32 LerpWords(u32 a, u32 b, float t)
+{
+  float fa, fb;
+  std::memcpy(&fa, &a, 4);
+  std::memcpy(&fb, &b, 4);
+  const float v = fa + (fb - fa) * t;
+  u32 out;
+  std::memcpy(&out, &v, 4);
+  return out;
+}
+
+// Zuordnung wie spike.match: gemeinsamer Anfang und gemeinsames Ende direkt,
+// der Rest per laengster gemeinsamer Teilfolge (nur bis 1.500 x 1.500 Felder).
+void MatchDraws()
+{
+  const auto& a = s_draws_previous;
+  const auto& b = s_draws_current;
+  s_match_of_current.assign(b.size(), -1);
+  size_t head = 0;
+  while (head < a.size() && head < b.size() && a[head].signature == b[head].signature)
+    ++head;
+  size_t tail = 0;
+  while (tail < a.size() - head && tail < b.size() - head &&
+         a[a.size() - 1 - tail].signature == b[b.size() - 1 - tail].signature)
+    ++tail;
+  for (size_t i = 0; i < head; ++i)
+    s_match_of_current[i] = static_cast<int>(i);
+  for (size_t k = 0; k < tail; ++k)
+    s_match_of_current[b.size() - tail + k] = static_cast<int>(a.size() - tail + k);
+  const size_t n = a.size() - head - tail, m = b.size() - head - tail;
+  if (n == 0 || m == 0 || n > 1500 || m > 1500)
+    return;
+  std::vector<u16> table((n + 1) * (m + 1), 0);
+  auto T = [&](size_t i, size_t j) -> u16& { return table[i * (m + 1) + j]; };
+  for (size_t i = n; i-- > 0;)
+    for (size_t j = m; j-- > 0;)
+      T(i, j) = a[head + i].signature == b[head + j].signature ?
+                    static_cast<u16>(T(i + 1, j + 1) + 1) :
+                    std::max(T(i + 1, j), T(i, j + 1));
+  size_t i = 0, j = 0;
+  while (i < n && j < m)
+  {
+    if (a[head + i].signature == b[head + j].signature)
+    {
+      s_match_of_current[head + j] = static_cast<int>(head + i);
+      ++i;
+      ++j;
+    }
+    else if (T(i + 1, j) >= T(i, j + 1))
+      ++i;
+    else
+      ++j;
+  }
+}
+
+// Laedt ein XF-Wort-Paket ueber den regulaeren Weg (mit Flush und Markierung).
+void LoadWords(u32 address, const std::vector<u32>& words)
+{
+  std::vector<u8> be(words.size() * 4);
+  for (size_t k = 0; k < words.size(); ++k)
+  {
+    be[k * 4 + 0] = static_cast<u8>(words[k] >> 24);
+    be[k * 4 + 1] = static_cast<u8>(words[k] >> 16);
+    be[k * 4 + 2] = static_cast<u8>(words[k] >> 8);
+    be[k * 4 + 3] = static_cast<u8>(words[k]);
+  }
+  for (size_t off = 0; off < words.size(); off += 16)
+  {
+    const u8 n = static_cast<u8>(std::min<size_t>(16, words.size() - off));
+    LoadXFReg(static_cast<u16>(address + off), n, be.data() + off * 4);
+  }
+}
+
+u64 s_first_short = 0;       // erster solcher Durchlauf (1-basiert), 0 = keiner
+std::string s_dump_dir;      // MODERNGEKKO_GX_DRYRUN_DUMP
+
+// Registerstand am Anfang der Mitschrift. Der Strom eines Bildes setzt nicht
+// jedes Register neu; was er vom Vorbild erbt (etwa Vertexformat und
+// -beschreibung), muss der zweite Durchlauf ebenso erben -- sonst liest er
+// die Zeichenbefehle mit falscher Vertexgroesse und laeuft versetzt (gemessen:
+// 15 von 2.403 Bildern, docs/20).
+struct Snapshot
+{
+  CPState cp;
+  XFMemory xf;
+  BPMemory bp;
+};
+Snapshot s_start;   // Stand am Anfang der laufenden Mitschrift
+Snapshot s_end;     // Stand am Ende, wird nach dem zweiten Durchlauf zurueckgesetzt
+
+void Take(Snapshot* into)
+{
+  std::memcpy(&into->cp, &g_main_cp_state, sizeof(CPState));
+  std::memcpy(&into->xf, &xfmem, sizeof(XFMemory));
+  std::memcpy(&into->bp, &bpmem, sizeof(BPMemory));
+}
+
+void Apply(const Snapshot& from)
+{
+  auto& system = Core::System::GetInstance();
+  std::memcpy(&g_main_cp_state, &from.cp, sizeof(CPState));
+  std::memcpy(&xfmem, &from.xf, sizeof(XFMemory));
+  std::memcpy(&bpmem, &from.bp, sizeof(BPMemory));
+  // Wie VideoCommon_DoState nach dem Laden eines Sicherungsstands.
+  VertexLoaderManager::MarkAllDirty();
+  system.GetPixelShaderManager().Dirty();
+  system.GetGeometryShaderManager().Dirty();
+  system.GetXFStateManager().InvalidateXFRange(0, 0x1000);
+  system.GetXFStateManager().SetProjectionChanged();
+  system.GetPixelShaderManager().SetViewportChanged();
+}
+}  // namespace
+
+void CountVertices(int count)
+{
+  (g_active ? s_vertices : s_vertices_first) += static_cast<u64>(count);
+}
+
+void CountDraw()
+{
+  ++(g_active ? s_draws : s_draws_first);
+}
+
+void OnDraw(int primitive, int vat, int count, int vertex_size, int pos_kind, bool per_vertex_matrix)
+{
+  if (!g_interpolate)
+    return;
+  if (!g_active)
+  {
+    DrawRecord r;
+    r.signature = std::make_tuple(primitive, vat, count, vertex_size, pos_kind, per_vertex_matrix);
+    TakeMatrices(&r);
+    s_draws_current.push_back(std::move(r));
+    return;
+  }
+  // Zweiter Durchlauf von B: Zeichenbefehl j.
+  const size_t j = static_cast<size_t>(s_draw_index++);
+  if (j >= s_match_of_current.size() || s_match_of_current[j] < 0)
+    return;
+  const DrawRecord& da = s_draws_previous[static_cast<size_t>(s_match_of_current[j])];
+  const DrawRecord& db = s_draws_current[j];
+  ++s_draws_matched;
+  // Geaenderte Woerter als zusammenhaengende Pakete laden.
+  bool patched = false;
+  int run_start = -1;
+  std::vector<u32> run;
+  auto flush_run = [&]() {
+    if (run_start >= 0)
+    {
+      LoadWords(SnapshotAddress(run_start), run);
+      s_words_interpolated += run.size();
+      patched = true;
+    }
+    run_start = -1;
+    run.clear();
+  };
+  for (int i = 0; i < kSnapshotWords; ++i)
+  {
+    if (da.matrices[i] != db.matrices[i])
+    {
+      if (run_start >= 0 && SnapshotAddress(i) != SnapshotAddress(run_start) + run.size())
+        flush_run();
+      if (run_start < 0)
+        run_start = i;
+      run.push_back(LerpWords(da.matrices[i], db.matrices[i], s_t));
+    }
+    else if (run_start >= 0)
+      flush_run();
+  }
+  flush_run();
+  if (da.projection != db.projection && da.projection[6] == db.projection[6])
+  {
+    std::vector<u32> p(kProjectionWords);
+    for (int i = 0; i < 6; ++i)
+      p[i] = LerpWords(da.projection[i], db.projection[i], s_t);
+    p[6] = db.projection[6];
+    LoadWords(0x1020, p);
+    ++s_projection_patched;
+    patched = true;
+  }
+  if (patched)
+    ++s_draws_patched;
+}
+
+bool BlocksBPRegister(u8 address)
+{
+  switch (address)
+  {
+  case BPMEM_TRIGGER_EFB_COPY:
+  case BPMEM_CLEARBBOX1:
+  case BPMEM_CLEARBBOX2:
+  case BPMEM_SETDRAWDONE:
+  case BPMEM_PE_TOKEN_ID:
+  case BPMEM_PE_TOKEN_INT_ID:
+  case BPMEM_LOADTLUT0:
+  case BPMEM_LOADTLUT1:
+  case BPMEM_TEXINVALIDATE:
+  case BPMEM_PRELOAD_MODE:
+  case BPMEM_CLEAR_PIXEL_PERF:
+    if (g_active)
+      ++s_blocked_bp;
+    return true;
+  default:
+    return false;
+  }
+}
+
+void Record(const u8* data, u32 size)
+{
+  s_buffer.insert(s_buffer.end(), data, data + size);
+  s_bytes += size;
+}
+
+static void SecondPass(PresentInfo&)
+{
+  if (s_buffer.empty())
+    return;
+  // Der zweite Durchlauf laeuft auf demselben Faden wie der erste, nach dem
+  // Praesentieren. Die Mitschrift enthaelt Display-Listen bereits aufgeloest.
+  auto& system = Core::System::GetInstance();
+  // Nichts, was der Gast liest, darf sich aendern: die Bounding Box wird im
+  // Pixelshader fortgeschrieben, die Pixelzaehler beim Zeichnen.
+  const bool bbox_was_enabled = g_bounding_box && g_bounding_box->IsEnabled();
+  if (bbox_was_enabled)
+    g_bounding_box->Disable(system.GetPixelShaderManager());
+  if (!g_no_draw)
+    g_framebuffer_manager->SwapInShadow();
+  Take(&s_end);
+  Apply(s_start);
+  bool interpolate_this = false;
+  if (g_interpolate)
+  {
+    MatchDraws();
+    size_t matched = 0;
+    for (int k : s_match_of_current)
+      matched += k >= 0;
+    const size_t larger = std::max(s_draws_previous.size(), s_draws_current.size());
+    interpolate_this = larger > 0 && matched * 10 >= larger * 6;  // spike.cut_verdict: share_floor 0.6
+    if (!interpolate_this)
+    {
+      ++s_cuts;
+      std::fill(s_match_of_current.begin(), s_match_of_current.end(), -1);
+    }
+    else
+      ++s_frames_interpolated;
+    s_draw_index = 0;
+  }
+  g_active = true;
+  u32 cycles = 0;
+  DataReader reader(s_buffer.data(), s_buffer.data() + s_buffer.size());
+  const u8* end = OpcodeDecoder::RunFifo<false>(reader, &cycles);
+  const u64 decoded = static_cast<u64>(end - s_buffer.data());
+  s_decoded_bytes += decoded;
+  if (decoded != s_buffer.size())
+  {
+    ++s_short_frames;
+    if (s_first_short == 0)
+      s_first_short = s_frames + 1;
+    std::fprintf(stderr, "[gx-dryrun] Durchlauf %llu: %llu von %llu Bytes dekodiert\n",
+                 (unsigned long long)(s_frames + 1), (unsigned long long)decoded,
+                 (unsigned long long)s_buffer.size());
+  }
+  g_vertex_manager->Flush();
+  g_active = false;
+  if (!g_no_draw)
+  {
+    const bool dump_now = !s_dump_dir.empty() &&
+                          (s_dump_count ? (s_frames >= s_dump_from && s_frames < s_dump_from + s_dump_count)
+                                        : (s_frames % 60) == 0);
+    if (dump_now)
+    {
+      // Der Schatten ist gerade der aktive EFB; sein Farbbild abspeichern.
+      if (g_framebuffer_manager->GetEFBColorTexture()->Save(
+              s_dump_dir + "/schatten_" + std::to_string(s_frames) + ".png", 0))
+        ++s_shadow_dumps;
+      // Zum Vergleich der eigentliche EFB zu diesem Zeitpunkt (nach dem Tausch
+      // ist er der Schatten-Zeiger).
+      g_framebuffer_manager->SwapOutShadow();
+      g_framebuffer_manager->GetEFBColorTexture()->Save(
+          s_dump_dir + "/efb_" + std::to_string(s_frames) + ".png", 0);
+      g_framebuffer_manager->SwapInShadow();
+    }
+    g_framebuffer_manager->SwapOutShadow();
+  }
+  Apply(s_end);
+  if (bbox_was_enabled)
+    g_bounding_box->Enable(system.GetPixelShaderManager());
+  ++s_frames;
+  s_buffer.clear();
+  if (g_interpolate)
+  {
+    s_draws_previous.swap(s_draws_current);
+    s_draws_current.clear();
+  }
+  Take(&s_start);  // die naechste Mitschrift beginnt hier
+}
+
+void Initialize()
+{
+  const char* stufe = std::getenv("MODERNGEKKO_GX_DRYRUN");
+  g_capture = stufe != nullptr;
+  g_no_draw = !(stufe && (stufe[0] == '2' || stufe[0] == '3'));
+  g_interpolate = stufe && stufe[0] == '3';
+  if (const char* f = std::getenv("MODERNGEKKO_GX_DRYRUN_DUMP_FROM"))
+    s_dump_from = std::strtoull(f, nullptr, 10);
+  if (const char* c = std::getenv("MODERNGEKKO_GX_DRYRUN_DUMP_COUNT"))
+    s_dump_count = std::strtoull(c, nullptr, 10);
+  const char* dump = std::getenv("MODERNGEKKO_GX_DRYRUN_DUMP");
+  s_dump_dir = dump ? dump : "";
+  g_active = false;
+  s_buffer.clear();
+  s_frames = s_bytes = s_blocked_bp = s_decoded_bytes = s_vertices = s_shadow_dumps = 0;
+  s_vertices_first = s_draws = s_draws_first = s_short_frames = s_first_short = 0;
+  if (!g_capture)
+    return;
+  s_buffer.reserve(4u << 20);
+  Take(&s_start);
+  s_after_present = Core::System::GetInstance().GetVideoEvents().after_present_event.Register(
+      SecondPass);
+}
+
+void Shutdown()
+{
+  s_after_present.reset();
+  if (g_capture)
+  {
+    std::fprintf(stderr,
+                 "[gx-dryrun] stufe=%d frames=%llu bytes=%llu decoded=%llu blocked_bp=%llu "
+                 "vertices=%llu/%llu draws=%llu/%llu schattenbilder=%llu kurz=%llu/erster=%llu "
+                 "interp: frames=%llu cuts=%llu matched=%llu patched=%llu words=%llu proj=%llu\n",
+                 g_interpolate ? 3 : g_no_draw ? 1 : 2, (unsigned long long)s_frames, (unsigned long long)s_bytes,
+                 (unsigned long long)s_decoded_bytes, (unsigned long long)s_blocked_bp,
+                 (unsigned long long)s_vertices, (unsigned long long)s_vertices_first,
+                 (unsigned long long)s_draws, (unsigned long long)s_draws_first,
+                 (unsigned long long)s_shadow_dumps, (unsigned long long)s_short_frames,
+                 (unsigned long long)s_first_short, (unsigned long long)s_frames_interpolated,
+                 (unsigned long long)s_cuts, (unsigned long long)s_draws_matched,
+                 (unsigned long long)s_draws_patched, (unsigned long long)s_words_interpolated,
+                 (unsigned long long)s_projection_patched);
+  }
+  g_capture = false;
+  g_active = false;
+  s_buffer.clear();
+  s_buffer.shrink_to_fit();
+}
+}  // namespace GXDryRun

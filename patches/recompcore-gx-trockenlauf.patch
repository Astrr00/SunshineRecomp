+bool g_interpolate = false;
+constexpr int kSnapshotWords = 256 + 96 + 256;  // 0x000-0x0FF, 0x400-0x45F, 0x500-0x5FF
+constexpr int kProjectionWords = 7;              // 0x1020-0x1026
+struct DrawRecord
+{

+
+void Take(Snapshot* into)
+{
+  std::memcpy(&into->cp, &g_main_cp_state, sizeof(CPState));
+  std::memcpy(&into->xf, &xfmem, sizeof(XFMemory));
+  std::memcpy(&into->bp, &bpmem, sizeof(BPMemory));
+  // Erst messen, dann schreiben -- wie State::SaveToBuffer.
+  static u8 s_measure_base;
+  u8* cursor = &s_measure_base;
+  PointerWrap measure(&cursor, 0, PointerWrap::Mode::Measure);
+  DoManagers(measure);
+  into->managers.resize(static_cast<size_t>(cursor - &s_measure_base));
+  u8* out = into->managers.data();
+  PointerWrap write(&out, into->managers.size(), PointerWrap::Mode::Write);
+  DoManagers(write);
+}
+
+void Apply(const Snapshot& from)
+{
+  std::memcpy(&g_main_cp_state, &from.cp, sizeof(CPState));
+  std::memcpy(&xfmem, &from.xf, sizeof(XFMemory));
+  std::memcpy(&bpmem, &from.bp, sizeof(BPMemory));
+  CopyPreprocessCPStateFromMain();
+  // Die Verwalter lesen ihren Stand zurueck und markieren sich schmutzig.
+  std::vector<u8> copy = from.managers;
+  u8* in = copy.data();
+  PointerWrap read(&in, copy.size(), PointerWrap::Mode::Read);
+  DoManagers(read);
+  // Wie VideoCommon_DoState nach dem Laden eines Sicherungsstands.
+  BPReload();
+  VertexLoaderManager::MarkAllDirty();
+}

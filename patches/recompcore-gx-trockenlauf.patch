+void FramebufferManager::SwapInShadow()
+{
+  if (m_shadow_active)
+    return;
+  const u32 width = m_efb_color_texture->GetWidth();
+  const u32 height = m_efb_color_texture->GetHeight();
+  if (!m_shadow_color_texture || m_shadow_color_texture->GetWidth() != width ||
+      m_shadow_color_texture->GetHeight() != height)
+  {
+    const TextureConfig color_config = GetEFBColorTextureConfig(width, height);
+    const TextureConfig depth_config = GetEFBDepthTextureConfig(width, height);
+    m_shadow_color_texture = g_gfx->CreateTexture(color_config, "Shadow EFB color texture");
+    m_shadow_convert_color_texture =
+        g_gfx->CreateTexture(color_config, "Shadow EFB convert color texture");
+    m_shadow_depth_texture = g_gfx->CreateTexture(depth_config, "Shadow EFB depth texture");
+    if (!m_shadow_color_texture || !m_shadow_convert_color_texture || !m_shadow_depth_texture)
+      return;
+    m_shadow_framebuffer =
+        g_gfx->CreateFramebuffer(m_shadow_color_texture.get(), m_shadow_depth_texture.get());
+    m_shadow_convert_framebuffer = g_gfx->CreateFramebuffer(m_shadow_convert_color_texture.get(),
+                                                            m_shadow_depth_texture.get());
+    if (!m_shadow_framebuffer || !m_shadow_convert_framebuffer)
+      return;
+  }
+  std::swap(m_efb_color_texture, m_shadow_color_texture);
+  std::swap(m_efb_convert_color_texture, m_shadow_convert_color_texture);
+  std::swap(m_efb_depth_texture, m_shadow_depth_texture);
+  std::swap(m_efb_framebuffer, m_shadow_framebuffer);
+  std::swap(m_efb_convert_framebuffer, m_shadow_convert_framebuffer);
+  m_shadow_active = true;
+  BindEFBFramebuffer();
+  // Der Schatten beginnt leer -- die EFB-Kopie mit Loeschen, die das Bild
+  // sonst einleitet, ist im zweiten Durchlauf gesperrt.
+  ClearEFB(MathUtil::Rectangle<int>(0, 0, EFB_WIDTH, EFB_HEIGHT), true, true, true, 0,
+           0xFFFFFF, bpmem.zcontrol.pixel_format);
+}
+
+void FramebufferManager::SwapOutShadow()
+{
+  if (!m_shadow_active)
+    return;
+  std::swap(m_efb_color_texture, m_shadow_color_texture);
+  std::swap(m_efb_convert_color_texture, m_shadow_convert_color_texture);
+  std::swap(m_efb_depth_texture, m_shadow_depth_texture);
+  std::swap(m_efb_framebuffer, m_shadow_framebuffer);
+  std::swap(m_efb_convert_framebuffer, m_shadow_convert_framebuffer);
+  m_shadow_active = false;
+  BindEFBFramebuffer();
+}

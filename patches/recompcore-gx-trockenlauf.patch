+  std::array<u32, kSnapshotWords> matrices;
+  std::array<u32, kProjectionWords> projection;
+};
+std::vector<DrawRecord> s_draws_previous;   // Bild A
+std::vector<DrawRecord> s_draws_current;    // Bild B, waehrend der Mitschrift
+std::vector<int> s_match_of_current;        // je Zeichenbefehl von B: Index in A oder -1
+u64 s_draw_index = 0;                       // laufender Zeichenbefehl im zweiten Durchlauf
+u64 s_frames_interpolated = 0, s_draws_matched = 0, s_draws_patched = 0, s_words_interpolated = 0,

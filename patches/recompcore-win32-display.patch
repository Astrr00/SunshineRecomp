+void PlatformWin32::SetClientSize(int width, int height)
+{
+  const PhysicalPixelScope dpi_scope;
+  RECT rect{0, 0, width, height};
+  AdjustWindowRectExForDpi(&rect, static_cast<DWORD>(GetWindowLongPtr(m_hwnd, GWL_STYLE)),
+                          FALSE, static_cast<DWORD>(GetWindowLongPtr(m_hwnd, GWL_EXSTYLE)),
+                          GetDpiForWindow(m_hwnd));
+  SetWindowPos(m_hwnd, nullptr, 0, 0, rect.right - rect.left, rect.bottom - rect.top,
+               SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);
+}
+
+void PlatformWin32::SetFullscreen(bool enabled)
+{
+  const PhysicalPixelScope dpi_scope;
+  if (enabled == m_window_fullscreen) return;
+  if (enabled)
+  {
+    UpdateWindowPosition();
+    GetWindowPlacement(m_hwnd, &m_windowed_placement);
+    m_windowed_style = GetWindowLongPtr(m_hwnd, GWL_STYLE);
+    m_windowed_ex_style = GetWindowLongPtr(m_hwnd, GWL_EXSTYLE);
+    MONITORINFO monitor{sizeof(MONITORINFO)};
+    if (!GetMonitorInfo(MonitorFromWindow(m_hwnd, MONITOR_DEFAULTTONEAREST), &monitor)) return;
+    m_window_fullscreen = true;
+    SetWindowLongPtr(m_hwnd, GWL_STYLE, (m_windowed_style & ~WS_OVERLAPPEDWINDOW) | WS_POPUP);
+    SetWindowLongPtr(m_hwnd, GWL_EXSTYLE, m_windowed_ex_style & ~WS_EX_CLIENTEDGE);
+    const auto& rect = monitor.rcMonitor;
+    SetWindowPos(m_hwnd, HWND_TOP, rect.left, rect.top, rect.right - rect.left,
+                 rect.bottom - rect.top, SWP_FRAMECHANGED | SWP_NOACTIVATE);
+  }
+  else
+  {
+    m_window_fullscreen = false;
+    SetWindowLongPtr(m_hwnd, GWL_STYLE, m_windowed_style);
+    SetWindowLongPtr(m_hwnd, GWL_EXSTYLE, m_windowed_ex_style);
+    SetWindowPlacement(m_hwnd, &m_windowed_placement);
+    SetWindowPos(m_hwnd, nullptr, 0, 0, 0, 0,
+                 SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_FRAMECHANGED | SWP_NOACTIVATE);
+  }
+}
+
+bool PlatformWin32::RequestFullscreenToggle()
+{
+  return PostMessage(m_hwnd, TOGGLE_FULLSCREEN, 0, 0) != 0;
+}
+
+void PlatformWin32::SaveWindowGeometry()
+{
+  UpdateWindowPosition();
+  Config::SetBase(Config::MAIN_FULLSCREEN, m_window_fullscreen.load());
+  Config::SetBase(Config::MAIN_RENDER_WINDOW_XPOS, m_window_x);
+  Config::SetBase(Config::MAIN_RENDER_WINDOW_YPOS, m_window_y);
+  Config::SetBase(Config::MAIN_RENDER_WINDOW_WIDTH, m_window_width);
+  Config::SetBase(Config::MAIN_RENDER_WINDOW_HEIGHT, m_window_height);
 }
 
